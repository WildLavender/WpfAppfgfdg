<Window x:Class="CollegeGradeSystem.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:conv="clr-namespace:CollegeGradeSystem.Converters"
        mc:Ignorable="d"
        Title="College Grade System - Управление успеваемостью"
        Height="800" Width="1200"
        WindowState="Maximized"
        Background="{DynamicResource BackgroundBrush}">

    <Window.Resources>
        <conv:RoleToVisibilityConverter x:Key="RoleToVisibilityConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource WindowBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="📚 Студенты" Click="btnStudents_Click"
                                Style="{StaticResource PrimaryButton}" Margin="0,0,10,0"/>
                        <Button Content="👥 Группы" Click="btnGroups_Click"
                                Style="{StaticResource PrimaryButton}" Margin="0,0,10,0"
                                Visibility="{Binding Converter={StaticResource RoleToVisibilityConverter}, 
                                             ConverterParameter='Администратор,Преподаватель'}"/>
                        <Button Content="⚙️ Управление" Click="btnAdmin_Click"
                                Style="{StaticResource PrimaryButton}" Margin="0,0,15,0"
                                Visibility="{Binding Converter={StaticResource RoleToVisibilityConverter}, 
                                             ConverterParameter='Администратор'}"/>
                    </StackPanel>

                    <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="5" Padding="12,6" Margin="10,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="👤 " FontSize="14" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding UserDisplay}" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <ComboBox x:Name="cmbTheme" Width="130" Height="36" SelectionChanged="cmbTheme_SelectionChanged" SelectedIndex="0" Margin="0,0,15,0">
                        <ComboBoxItem Content="☀️ Светлая" Tag="LightTheme"/>
                        <ComboBoxItem Content="🌙 Тёмная" Tag="DarkTheme"/>
                    </ComboBox>

                    <Button x:Name="btnNotifications" Click="btnNotifications_Click" Width="40" Height="40" Margin="0,0,15,0"
                            Background="Transparent" BorderThickness="0" Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasUnread}" Value="True">
                                        <Setter Property="Foreground" Value="#FFC107"/>
                                    </DataTrigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Grid>
                                    <TextBlock Text="🔔" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <Border x:Name="Badge" HorizontalAlignment="Right" VerticalAlignment="Top"
                                            Background="#FFC107" CornerRadius="10" MinWidth="18" Height="18"
                                            Padding="4,0,4,0" Visibility="Collapsed" Margin="0,-5,-5,0">
                                        <TextBlock Text="{Binding UnreadCount}" FontSize="11" FontWeight="Bold" Foreground="White" TextAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <DataTrigger Binding="{Binding HasUnread}" Value="True">
                                        <Setter TargetName="Badge" Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <Button Content="⚙️" Click="btnSettings_Click" Width="36" Height="36" Margin="0,0,15,0" FontSize="18"
                            Background="Transparent" BorderThickness="0" ToolTip="Настройки оповещений" Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button Content="🚪 Выйти" Click="btnLogout_Click" Style="{StaticResource SecondaryButton}" Height="36" Padding="15,5"
                            Background="{DynamicResource ErrorBrush}" Foreground="White" BorderBrush="{DynamicResource ErrorBrush}"/>
                </StackPanel>
            </Grid>
        </Border>

        <ContentControl Grid.Row="1" x:Name="MainContent"/>
    </Grid>
</Window>