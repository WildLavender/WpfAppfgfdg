<UserControl x:Class="CollegeGradeSystem.Views.NotificationSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource BackgroundBrush}">
    <Border Background="{DynamicResource WindowBackgroundBrush}" CornerRadius="10" Padding="30" Width="500" HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel>
            <TextBlock Text="⚙️ Настройки оповещений" Style="{StaticResource TitleTextBlock}" HorizontalAlignment="Center" Margin="0,0,0,25"/>

            <CheckBox Content="📧 Получать email-уведомления" IsChecked="{Binding Settings.ReceiveEmail}" Margin="0,0,0,15"/>
            <CheckBox Content="💬 Внутрисистемные уведомления" IsChecked="{Binding Settings.ReceiveInApp}" Margin="0,0,0,15"/>

            <TextBlock Text="События для уведомлений:" FontWeight="SemiBold" Margin="0,10,0,5"/>
            <CheckBox Content="Добавление нового студента" IsChecked="{Binding Settings.EmailForNewStudent}" Margin="20,0,0,10"/>
            <CheckBox Content="Системные предупреждения" IsChecked="{Binding Settings.EmailForSystemAlerts}" Margin="20,0,0,25"/>

            <Button Content="💾 Сохранить настройки" Command="{Binding SaveCommand}" Height="40" Style="{StaticResource PrimaryButton}"/>
        </StackPanel>
    </Border>
</UserControl>