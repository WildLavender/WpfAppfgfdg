<UserControl x:Class="CollegeGradeSystem.Views.StudentsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:conv="clr-namespace:CollegeGradeSystem.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800">

    <UserControl.Resources>
        <!-- Локальный ресурс для конвертера ролей -->
        <conv:RoleToVisibilityConverter x:Key="RoleToVisibilityConverter"/>
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Панель поиска и фильтрации -->
        <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                Background="{DynamicResource WindowBackgroundBrush}" 
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" 
                CornerRadius="5" Padding="15" Margin="0,0,0,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0" 
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         Height="45" Margin="0,0,10,0"
                         VerticalContentAlignment="Center"/>

                <!-- 🔹 ComboBox фильтрации групп -->
                <ComboBox Grid.Column="1" 
                          ItemsSource="{Binding Groups}"
                          DisplayMemberPath="name" 
                          SelectedValuePath="id_group"
                          SelectedValue="{Binding SelectedGroupId}"
                          Height="45" Margin="0,0,10,0"
                          VerticalContentAlignment="Center"
                          Background="{DynamicResource InputBackgroundBrush}"
                          Foreground="{DynamicResource InputForegroundBrush}"
                          BorderBrush="{DynamicResource InputBorderBrush}">
                    <ComboBox.ItemContainerStyle>
                        <Style TargetType="ComboBoxItem">
                            <Setter Property="Background" Value="{DynamicResource InputPopupBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource InputForegroundBrush}"/>
                            <Setter Property="Padding" Value="8,6"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ComboBox.ItemContainerStyle>
                </ComboBox>

                <Button Grid.Column="2" Content="🔍 Найти" 
                        Command="{Binding SearchCommand}"
                        Height="45" Width="100" Margin="0,0,10,0"
                        Style="{StaticResource PrimaryButton}"/>

                <Button Grid.Column="3" Content="✕ Сброс" 
                        Command="{Binding ClearFilterCommand}"
                        Height="45" Width="100" Margin="0,0,10,0"
                        Style="{StaticResource SecondaryButton}"/>

                <Button Grid.Column="4" Content="📊 Экспорт" 
                        Command="{Binding ExportCommand}"
                        Height="45" Width="100"
                        Style="{StaticResource SuccessButton}"/>
            </Grid>
        </Border>

        <!-- Таблица студентов -->
        <DataGrid Grid.Row="1" Grid.Column="0" Margin="0,0,15,0"
                  ItemsSource="{Binding Students}"
                  SelectedItem="{Binding SelectedStudent, UpdateSourceTrigger=PropertyChanged}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  RowHeight="45">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding id_student}" Width="50"/>
                <DataGridTextColumn Header="ФИО" Binding="{Binding full_name}" Width="200"/>
                <DataGridTextColumn Header="Дата рождения" 
                                    Binding="{Binding birth_date, StringFormat={}{0:dd.MM.yyyy}}" 
                                    Width="120"/>
                <DataGridTextColumn Header="Группа" Binding="{Binding group_name}" Width="100"/>
                <DataGridTextColumn Header="Email" Binding="{Binding email}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Форма добавления/редактирования -->
        <Border Grid.Row="1" Grid.Column="1"
                Background="{DynamicResource WindowBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="5"
                Padding="15">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Данные студента" 
                           Style="{StaticResource TitleTextBlock}"
                           Margin="0,0,0,15"/>

                <TextBlock Grid.Row="1" Text="ID:" Margin="0,0,0,5"/>
                <!-- 🔹 ИСПРАВЛЕНО: EditStudent → CurrentEntity -->
                <TextBox Grid.Row="2" 
                         Text="{Binding CurrentEntity.id_student, UpdateSourceTrigger=PropertyChanged}"
                         IsEnabled="False"
                         Height="45" Margin="0,0,0,15"
                         VerticalContentAlignment="Center"/>

                <TextBlock Grid.Row="3" Text="ФИО:" Margin="0,0,0,5"/>
                <!-- 🔹 ИСПРАВЛЕНО: EditStudent → CurrentEntity -->
                <TextBox Grid.Row="4" 
                         Text="{Binding CurrentEntity.full_name, UpdateSourceTrigger=PropertyChanged}"
                         Height="45" Margin="0,0,0,15"
                         VerticalContentAlignment="Center"/>

                <TextBlock Grid.Row="5" Text="Дата рождения:" Margin="5,0,5,0"/>
                <!-- 🔹 ИСПРАВЛЕНО: EditStudent → CurrentEntity -->
                <DatePicker Grid.Row="6" 
                            SelectedDate="{Binding CurrentEntity.birth_date, UpdateSourceTrigger=PropertyChanged}"
                            Height="45" 
                            MinWidth="345"
                            Width="345"
                            HorizontalAlignment="Left"
                            Margin="0,0,0,15"/>

                <TextBlock Grid.Row="7" Text="Группа:" Margin="0,0,0,5"/>

                <!-- 🔹 ComboBox выбора группы в форме -->
                <!-- 🔹 ИСПРАВЛЕНО: EditStudent → CurrentEntity -->
                <ComboBox Grid.Row="8"
                          ItemsSource="{Binding Groups}"
                          DisplayMemberPath="name" 
                          SelectedValuePath="id_group"
                          SelectedValue="{Binding CurrentEntity.id_group, UpdateSourceTrigger=PropertyChanged}"
                          Height="45" 
                          MinWidth="150"
                          Margin="0,0,0,25"
                          VerticalContentAlignment="Center"
                          Background="{DynamicResource InputBackgroundBrush}"
                          Foreground="{DynamicResource InputForegroundBrush}"
                          BorderBrush="{DynamicResource InputBorderBrush}">
                    <ComboBox.ItemContainerStyle>
                        <Style TargetType="ComboBoxItem">
                            <Setter Property="Background" Value="{DynamicResource InputPopupBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource InputForegroundBrush}"/>
                            <Setter Property="Padding" Value="8,6"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ComboBox.ItemContainerStyle>
                </ComboBox>

                <TextBlock Grid.Row="9" Text="Email:" Margin="0,0,0,5"/>
                <!-- 🔹 ИСПРАВЛЕНО: EditStudent → CurrentEntity -->
                <TextBox Grid.Row="10" 
                         Text="{Binding CurrentEntity.email, UpdateSourceTrigger=PropertyChanged}"
                         Height="45" 
                         MinWidth="150"
                         Margin="0,0,0,15"
                         VerticalContentAlignment="Center"/>

                <!-- Кнопки управления с ролевой защитой -->
                <StackPanel Grid.Row="11" Margin="0,20,0,0">

                    <!-- Кнопка "Добавить нового" -->
                    <Button Content="➕ Добавить нового" 
                            Command="{Binding AddCommand}"
                            Height="45" Margin="0,0,0,10"
                            Style="{StaticResource PrimaryButton}"
                            Visibility="{Binding Converter={StaticResource RoleToVisibilityConverter}, 
                                         ConverterParameter='Администратор,Преподаватель'}"/>

                    <!-- Кнопка "Сохранить" -->
                    <Button Content="💾 Сохранить" 
                            Command="{Binding SaveCommand}"
                            Height="45" Margin="0,0,0,10"
                            Style="{StaticResource SuccessButton}"
                            Visibility="{Binding Converter={StaticResource RoleToVisibilityConverter}, 
                                         ConverterParameter='Администратор,Преподаватель'}"/>

                    <!-- Кнопка "Удалить" -->
                    <Button Content="🗑 Удалить" 
                            Command="{Binding DeleteCommand}"
                            Height="45" Margin="0,0,0,10"
                            Style="{StaticResource DangerButton}"
                            Visibility="{Binding Converter={StaticResource RoleToVisibilityConverter}, 
                                         ConverterParameter='Администратор'}"/>

                    <!-- Кнопка "Обновить список" -->
                    <Button Content="🔄 Обновить список" 
                            Command="{Binding RefreshCommand}"
                            Height="45"
                            Style="{StaticResource SecondaryButton}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>