<Window x:Class="CollegeGradeSystem.Views.PasswordRecoveryView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Восстановление пароля - СКИТ" 
        Height="700" Width="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource BackgroundBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,40">
                <TextBlock Text="🔐 Восстановление пароля" 
                           Style="{StaticResource TitleTextBlock}"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="СКИТ - Учебный портал" 
                           Style="{StaticResource SubtitleTextBlock}"
                           HorizontalAlignment="Center" Margin="0,10,0,0"/>
                <Line X1="0" Y1="0" X2="300" Y2="0" 
                      Stroke="{StaticResource PrimaryBrush}" StrokeThickness="2" 
                      Margin="0,20,0,0"/>
            </StackPanel>

            <StackPanel Grid.Row="1" x:Name="RequestPanel" Visibility="Visible">
                <TextBlock Text="Введите ваш email для восстановления доступа:" 
                           Style="{StaticResource HeaderTextBlock}"
                           Margin="0,0,0,20" TextWrapping="Wrap"/>

                <TextBlock Text="Email:" Margin="0,0,0,10"/>
                <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" 
                         Height="45" Margin="0,0,0,25"/>

                <Button Content="📧 Отправить токен" 
                        Command="{Binding SendTokenCommand}"
                        Height="50" Margin="0,30,0,0"/>
            </StackPanel>

            <StackPanel Grid.Row="1" x:Name="ResetPanel" Visibility="Collapsed">
                <TextBlock Text="Введите токен из письма и новый пароль:" 
                           Style="{StaticResource HeaderTextBlock}"
                           Margin="0,0,0,20" TextWrapping="Wrap"/>

                <TextBlock Text="Токен из письма:" Margin="0,0,0,10"/>
                <TextBox Text="{Binding Token, UpdateSourceTrigger=PropertyChanged}" 
                         Height="45" Margin="0,0,0,20" FontFamily="Consolas"/>

                <TextBlock Text="Новый пароль:" Margin="0,0,0,10"/>
                <PasswordBox x:Name="txtNewPassword" 
                             Height="45" Margin="0,0,0,20"/>

                <TextBlock Text="Подтвердите пароль:" Margin="0,0,0,10"/>
                <PasswordBox x:Name="txtConfirmPassword" 
                             Height="45" Margin="0,0,0,30"/>

                <Button Content="✅ Установить новый пароль" 
                        Command="{Binding ResetPasswordCommand}"
                        Height="50" Margin="0,15,0,0"
                        Style="{StaticResource SuccessButton}"/>
            </StackPanel>

            <StackPanel Grid.Row="2" Margin="0,30,0,0">
                <TextBlock Text="{Binding StatusMessage}" 
                           Foreground="{StaticResource ErrorBrush}" 
                           TextWrapping="Wrap"
                           HorizontalAlignment="Center" Margin="0,0,0,20"/>

                <Line X1="0" Y1="0" X2="400" Y2="0" 
                      Stroke="{StaticResource BorderBrush}" StrokeThickness="1" 
                      Margin="0,0,0,20"/>

                <Button Content="❌ Закрыть" 
                        Command="{Binding CloseCommand}"
                        Height="45" Style="{StaticResource SecondaryButton}"/>

                <TextBlock Text="© 2024 СКИТ - Столичный Колледж Информационных Технологий" 
                           Style="{StaticResource SubtitleTextBlock}"
                           HorizontalAlignment="Center" TextAlignment="Center"
                           Margin="0,20,0,0"/>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Window>