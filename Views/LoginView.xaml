<UserControl x:Class="CollegeGradeSystem.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="500"
             Background="{DynamicResource BackgroundBrush}">

    <Grid>
        <!-- 🔹 КНОПКА СМЕНЫ ТЕМЫ (Вынесена на передний план) -->
        <!-- Panel.ZIndex="1" заставляет кнопку рисоваться ПОВЕРХ белого окна -->
        <Button x:Name="ThemeToggleButton"
                Content=""
                Width="45" Height="45"
                HorizontalAlignment="Right" 
                VerticalAlignment="Top"
                Margin="0, 20, 20, 0"
                Panel.ZIndex="1" 
                Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                Cursor="Hand" 
                Click="ThemeToggleButton_Click"
                ToolTip="Сменить тему">
            <Button.Style>
                <Style TargetType="Button">
                    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                    <Setter Property="FontSize" Value="20"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="22">
                                    <!-- Круглая кнопка -->
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Button.Style>
        </Button>

        <!-- Белая карточка входа (теперь она ПОД кнопкой) -->
        <Border Background="{DynamicResource WindowBackgroundBrush}" 
                CornerRadius="10" 
                Width="400" Height="550"
                BorderBrush="{DynamicResource BorderBrush}" 
                BorderThickness="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel VerticalAlignment="Center" Margin="30">

                    <!-- Заголовок -->
                    <TextBlock Text="Вход в систему" 
                               x:Name="TitleLabel"
                               Style="{StaticResource TitleTextBlock}" 
                               HorizontalAlignment="Center" 
                               Margin="0,0,0,30"/>

                    <!-- Поле Логин -->
                    <TextBlock Text="Логин:" Style="{StaticResource HeaderTextBlock}" Margin="0,0,0,5"/>
                    <TextBox x:Name="TxtLogin" Height="40" Margin="0,0,0,15" 
                             VerticalContentAlignment="Center"/>

                    <!-- Поле Пароль -->
                    <TextBlock Text="Пароль:" Style="{StaticResource HeaderTextBlock}" Margin="0,0,0,5"/>
                    <PasswordBox x:Name="TxtPassword" Height="40" Margin="0,0,0,15" 
                                 VerticalContentAlignment="Center"/>

                    <!-- Подтверждение пароля (скрыто по умолчанию) -->
                    <StackPanel x:Name="ConfirmPanel" Visibility="Collapsed">
                        <TextBlock Text="Подтвердите пароль:" Style="{StaticResource HeaderTextBlock}" Margin="0,0,0,5"/>
                        <PasswordBox x:Name="TxtConfirmPassword" Height="40" Margin="0,0,0,15" 
                                     VerticalContentAlignment="Center"/>
                    </StackPanel>

                    <!-- Кнопка действия -->
                    <Button Content="Войти" 
                            x:Name="ActionButton"
                            Click="ActionButton_Click" 
                            Height="45" Margin="0,0,0,15"
                            FontSize="16"
                            Style="{StaticResource PrimaryButton}"/>

                    <!-- Переключатель регистрации -->
                    <Button Content="Нет аккаунта? Зарегистрироваться" 
                            Click="SwitchMode_Click" 
                            Background="Transparent" BorderThickness="0"
                            Foreground="{DynamicResource PrimaryBrush}"
                            Cursor="Hand"
                            Margin="0,10,0,0"
                            HorizontalAlignment="Center"/>

                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>