<UserControl x:Class="CollegeGradeSystem.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="📊 Отчёты и статистика" 
                   Style="{StaticResource TitleTextBlock}"
                   Margin="0,0,0,15"/>

        <StackPanel Grid.Row="1">
            <Border Background="{DynamicResource WindowBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="5"
                    Padding="20"
                    Margin="0,0,0,15">
                <StackPanel>
                    <TextBlock Text="📈 Общая статистика" 
                               Style="{StaticResource HeaderTextBlock}"
                               Margin="0,0,0,15"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                            <TextBlock Text="Всего студентов:" 
                                       FontWeight="Bold"
                                       Margin="0,0,0,5"
                                       Foreground="{DynamicResource TextBrush}"/>
                            <TextBlock x:Name="txtTotalStudents" 
                                       Text="0"
                                       FontSize="24"
                                       Foreground="{DynamicResource PrimaryBrush}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="10,0,10,0">
                            <TextBlock Text="Всего групп:" 
                                       FontWeight="Bold"
                                       Margin="0,0,0,5"
                                       Foreground="{DynamicResource TextBrush}"/>
                            <TextBlock x:Name="txtTotalGroups" 
                                       Text="0"
                                       FontSize="24"
                                       Foreground="{DynamicResource PrimaryBrush}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Margin="10,0,0,0">
                            <TextBlock Text="Всего преподавателей:" 
                                       FontWeight="Bold"
                                       Margin="0,0,0,5"
                                       Foreground="{DynamicResource TextBrush}"/>
                            <TextBlock x:Name="txtTotalTeachers" 
                                       Text="15"
                                       FontSize="24"
                                       Foreground="{DynamicResource PrimaryBrush}"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <Button Content="🔄 Обновить статистику" 
                    Click="btnRefresh_Click"
                    HorizontalAlignment="Left"
                    Padding="20,10"
                    Style="{StaticResource PrimaryButton}"/>
        </StackPanel>
    </Grid>
</UserControl>